{
  "name": "veriframe",
  "type": "module",
  "engines": {
    "node": ">=16.0.0",
    "pnpm": ">=7.0.0",
    "npm": "please use pnpm"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "check": "pnpm -r --if-present run check",
    "fix": "pnpm -r --if-present run fix",
    "bindgen": "icp-bindgen --did-file ./src/backend/dist/backend.did --out-dir ./src/frontend/src --actor-interface-file --force",
    "build:backend:win": "node windows-build.js"
  },
  "devDependencies": {
    "@icp-sdk/bindgen": "0.3.0",
    "motoko": "^4.3.0",
    "sharp": "^0.34.4"
  }
}
